# Unity regenerates these inside the Unity project from the asmdefs, so they
# are noise. The hand-authored project files under unity/Aetherlight.Core*
# are real source - without them `dotnet test` does not work on a fresh clone -
# so they are re-included below.
*.csproj
*.sln
!unity/Aetherlight.Core/Aetherlight.Core.csproj
!unity/Aetherlight.Core.Tests/Aetherlight.Core.Tests.csproj
!unity/tools/unity-stub/UnityEngine.Stub.csproj
!unity/tools/unity-stub/Aetherlight.Unity.Compile.csproj
