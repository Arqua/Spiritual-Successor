{
  "name": "aetherlight-core",
  "version": "0.1.0",
  "description": "Engine-agnostic core rules library for a classic-style elemental JRPG. Clean-room design, no rendering dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data/*": "./src/data/*"
  },
  "files": [
    "dist",
    "src",
    "schema",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/sim.ts",
    "schema": "tsx tools/emit-schema.ts",
    "demo": "esbuild demo/main.ts --bundle --format=esm --outfile=demo/bundle.js && echo \"open demo/index.html\""
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "jrpg",
    "turn-based",
    "rpg-engine",
    "game-rules",
    "engine-agnostic",
    "hd-2d"
  ]
}
